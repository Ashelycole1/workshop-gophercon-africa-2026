package pages

import (
	"workshop/web/safari"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Map(site *safari.Site) {
	@layout.Base(layout.BaseProps{
		Title:       "Map",
		Description: "Every African wildlife sighting on one map, filtered by animal, country and year.",
		Page:        "map",
		Tip:         "Drag around, there are animals everywhere.",
		Styles:      []string{"/assets/vendor/leaflet/leaflet.css", "/assets/vendor/leaflet/MarkerCluster.css", "/assets/css/map.css"},
		Scripts:     []string{"/assets/vendor/leaflet/leaflet.js", "/assets/vendor/leaflet/leaflet.markercluster.js", "/assets/js/map.js"},
	}) {
		<h1 class="sr-only">Map of every sighting</h1>
		<div class="atlas">
			<form class="atlas__panel" data-atlas-filters aria-label="Filter the map">
				<details class="atlas__details" open>
					<summary>
						@components.Icon("funnel")
						<span>Filters</span>
						<output class="atlas__count" aria-live="polite">Showing { itoa(len(site.Sightings)) } of { itoa(len(site.Sightings)) }</output>
					</summary>
					<fieldset class="atlas__group">
						<legend>Animal</legend>
						<div class="chips">
							for _, a := range site.Animals {
								<label class="chip chip--check">
									<input type="checkbox" name="animal" value={ a.Slug }/>
									<span>{ a.Name }</span>
									<span class="chip__count">{ itoa(len(a.Sightings)) }</span>
								</label>
							}
						</div>
					</fieldset>
					<fieldset class="atlas__group">
						<legend>Country</legend>
						<div class="chips">
							for _, c := range site.Countries {
								<label class="chip chip--check">
									<input type="checkbox" name="country" value={ c.Slug }/>
									@components.Silhouette(c.Code, "")
									<span>{ c.Name }</span>
									<span class="chip__count">{ itoa(len(c.Sightings)) }</span>
								</label>
							}
						</div>
					</fieldset>
					<fieldset class="atlas__group atlas__years">
						<legend>Years</legend>
						<label>
							<span>From</span>
							<select name="from">
								for _, y := range years(site) {
									<option value={ itoa(y) } selected?={ y == years(site)[0] }>{ itoa(y) }</option>
								}
							</select>
						</label>
						<label>
							<span>To</span>
							<select name="to">
								for _, y := range years(site) {
									<option value={ itoa(y) } selected?={ y == years(site)[len(years(site))-1] }>{ itoa(y) }</option>
								}
							</select>
						</label>
					</fieldset>
					<p class="atlas__actions">
						<button class="btn btn--ghost btn--small" type="reset">Clear filters</button>
						<a class="atlas__list" href="/sightings/">Prefer a list? Every sighting</a>
					</p>
				</details>
			</form>
			<div class="atlas__map" id="atlas" role="region" aria-label="Interactive map. Use the filters to narrow it; every sighting is also on the sightings page.">
				<noscript><p class="empty">The map needs JavaScript. Every sighting is on the <a href="/sightings/">sightings page</a>.</p></noscript>
			</div>
		</div>
		@templ.JSONScript("atlas-data", site.MapData())
	}
}
