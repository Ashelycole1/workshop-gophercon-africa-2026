package pages

import (
	"workshop/web/safari"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Home(site *safari.Site) {
	@layout.Base(layout.BaseProps{
		Title:       "",
		Description: "Real wildlife sightings, up close: photos, a 3D map of Africa and the weather on the day, built in Go for GopherCon Africa 2026.",
		Page:        "home",
		Styles:      []string{"/assets/css/home.css"},
		Scripts:     []string{"/assets/js/home.js", "/assets/js/wall.js", "/assets/js/moving.js"},
		Modules:     []string{"/assets/js/africa3d.js"},
	}) {
		<section class="hero" data-africa3d aria-labelledby="hero-title">
			<div class="hero__glow" aria-hidden="true"></div>
			<div class="hero__grid wrap">
				<div class="hero__copy">
					<p class="badge">
						@components.Icon("globe-hemisphere-east")
						<span>Sightings from { itoa(len(site.Countries)) } countries</span>
					</p>
					<h1 id="hero-title" class="hero__title">
						<span class="line"><span class="line__inner">Karibu. The wild,</span></span>
						<span class="line"><span class="line__inner">seen up <em class="script">close.</em></span></span>
					</h1>
					<p class="hero__lede">Every photo here was taken by someone who was there: on safari, on a boat, in a back garden. Spin the map, meet the animals, and see the weather on the day they were spotted.</p>
					<div class="hero__ctas">
						<a class="btn btn--primary" href="#sightings">
							<span>Explore sightings</span>
							<span class="btn__arrow">
								@components.Icon("arrow-up-right")
							</span>
						</a>
						<a class="hero__play" href="/map/">
							<span class="hero__play-icon">
								@components.Icon("map-trifold")
							</span>
							<span>Start the safari</span>
						</a>
					</div>
					<dl class="stats">
						<div class="stat">
							<dd data-count={ itoa(len(site.Sightings)) }>{ itoa(len(site.Sightings)) }</dd>
							<dt>Sightings</dt>
						</div>
						<div class="stat">
							<dd data-count={ itoa(len(site.Animals)) }>{ itoa(len(site.Animals)) }</dd>
							<dt>Species</dt>
						</div>
						<div class="stat">
							<dd data-count={ itoa(len(site.Countries)) }>{ itoa(len(site.Countries)) }</dd>
							<dt>Countries</dt>
						</div>
						<div class="stat">
							<dd data-count={ itoa(len(galleryPhotos(site))) }>{ itoa(len(galleryPhotos(site))) }</dd>
							<dt>Photos</dt>
						</div>
					</dl>
				</div>
				<div class="a3d">
					<div class="a3d__stage">
						@components.AfricaMap(site.Sightings, "", safari.MapViewBox(), "Map of Africa with a dot for each wildlife sighting")
					</div>
					<div class="a3d__tip" hidden>
						<img alt="" width="240" height="180" hidden/>
						<p class="a3d__tip-title"></p>
						<p class="a3d__tip-place"></p>
						<p class="a3d__tip-meta"></p>
					</div>
					<div class="a3d__hud">
						<p class="a3d__hint">
							@components.Icon("hand-grabbing")
							<span class="for-mouse">Drag to turn. Hover a pin to meet the animal.</span>
							<span class="for-touch">Swipe to turn, tap a pin</span>
						</p>
						<div class="a3d__controls" role="group" aria-label="Turn the map">
							<button type="button" data-turn="left" aria-label="Turn the map left">
								@components.Icon("caret-left")
							</button>
							<button type="button" data-turn="reset" aria-label="Reset the view">
								@components.Icon("compass")
							</button>
							<button type="button" data-turn="right" aria-label="Turn the map right">
								@components.Icon("caret-right")
							</button>
						</div>
					</div>
					<div class="a3d__legend" aria-hidden="true">
						<span>Fewer sightings</span>
						<span class="a3d__scale"></span>
						<span>More</span>
					</div>
				</div>
			</div>
			@templ.JSONScript("africa3d-data", site.Scene3D())
		</section>
		if shots := strip(site, 5); len(shots) > 0 {
			<section class="strip" aria-labelledby="strip-title" data-strip>
				<div class="wrap section__head">
					<div>
						<h2 id="strip-title">Fresh from the <em class="script">field</em></h2>
						<p class="section__note"><span class="for-mouse">The newest photos, one animal each. Point at one to open it up.</span><span class="for-touch">The newest photos, one animal each. Swipe through them.</span></p>
					</div>
					<div class="strip__nav" role="group" aria-label="Scroll the photos">
						<button type="button" class="strip__btn" data-strip-step="-1" aria-label="Previous photo">
							@components.Icon("arrow-left")
						</button>
						<button type="button" class="strip__btn" data-strip-step="1" aria-label="Next photo">
							@components.Icon("arrow-right")
						</button>
					</div>
				</div>
				<ul class="strip__row wrap" role="list">
					for i, s := range shots {
						<li class={ "strip__item", templ.KV("is-open", i == 0) }>
							<a class="strip__link" href={ templ.SafeURL(safari.SightingURL(s)) }>
								<img src={ safari.Sized(safari.Photo(s), "large") } alt={ safari.Alt(s) } loading="lazy" decoding="async" width="1024" height="768"/>
								<span class="strip__shade" aria-hidden="true"></span>
								<span class="strip__num" aria-hidden="true">0{ itoa(i + 1) }</span>
								<span class="strip__text">
									<strong class="strip__name">{ safari.AnimalName(s.Species) }</strong>
									<span class="strip__place">
										@components.Icon("map-pin")
										{ safari.Place(s) }, { safari.CountryName(s) }
									</span>
									<span class="strip__by">
										<time datetime={ safari.ISODate(s) }>{ safari.Date(s) }</time> · by { safari.Spotter(s) }
										if sky, ok := safari.Weather(s); ok {
											· { sky.Temp }, { sky.Word }
										}
									</span>
								</span>
							</a>
						</li>
					}
				</ul>
				<div class="strip__dots" aria-hidden="true">
					for i := range shots {
						<span class={ "strip__dot", templ.KV("is-on", i == 0) }></span>
					}
				</div>
			</section>
		}
		if s, ok := bestSpot(site); ok {
			<section class="spot wrap" aria-labelledby="spot-title">
				<a class="spot__photo" href={ templ.SafeURL(safari.SightingURL(s)) } data-tilt>
					<img src={ safari.Sized(safari.Photo(s), "large") } alt={ safari.Alt(s) } loading="lazy" width="1024" height="768"/>
					<span class="spot__sticker" aria-hidden="true">Today's pick</span>
				</a>
				<div class="spot__log">
					<h2 id="spot-title">Today's best <em class="script">spot</em></h2>
					<p class="spot__animal">
						<a href={ templ.SafeURL(safari.SightingURL(s)) }>{ safari.AnimalName(s.Species) }</a>
					</p>
					if s.Species.ScientificName != "" {
						<p class="spot__latin">{ s.Species.ScientificName }</p>
					}
					<dl class="log">
						<div>
							<dt>Seen</dt>
							<dd><time datetime={ safari.ISODate(s) }>{ safari.LongDate(s) }</time></dd>
						</div>
						<div>
							<dt>Where</dt>
							<dd>{ safari.FullPlace(s) }</dd>
						</div>
						<div>
							<dt>Spotted by</dt>
							<dd>{ safari.Spotter(s) }</dd>
						</div>
						if sky, ok := safari.Weather(s); ok {
							<div>
								<dt>Sky</dt>
								<dd>{ sky.Word }, { sky.Temp }. { sky.Verdict }.</dd>
							</div>
						}
					</dl>
					<p class="spot__fact">{ safari.Fact(safari.AnimalName(s.Species)) }</p>
					<a class="btn btn--forest" href={ templ.SafeURL(safari.SightingURL(s)) }>Open the field log</a>
				</div>
			</section>
		}
		<section id="sightings" class="section wall wrap" aria-labelledby="wall-title">
			<div class="section__head">
				<div>
					<h2 id="wall-title">Latest <em class="script">sightings</em></h2>
					<p class="section__note" data-wall-note>All { itoa(len(site.Sightings)) }, newest first.</p>
				</div>
				<button class="btn btn--ghost btn--small" type="button" data-wall-surprise hidden>
					@components.Icon("shuffle")
					<span>Surprise me</span>
				</button>
			</div>
			<form class="filters" data-wall="wall" role="search" aria-label="Filter sightings" hidden>
				<label class="field field--search">
					<span>Search</span>
					<span class="field__box">
						@components.Icon("magnifying-glass")
						<input type="search" name="q" placeholder="Lion, Kajiado, a spotter's name…" autocomplete="off"/>
					</span>
				</label>
				<button class="filters__toggle" type="button" aria-expanded="false" aria-controls="filters-more" data-filters-toggle>
					@components.Icon("funnel")
					<span>Filters</span>
					<span class="filters__count" data-filters-count hidden></span>
				</button>
				<div id="filters-more" class="filters__more">
					<label class="field">
						<span>Animal</span>
						<select name="animal">
							<option value="">Any animal</option>
							for _, a := range site.Animals {
								<option value={ a.Slug }>{ a.Name } ({ itoa(len(a.Sightings)) })</option>
							}
						</select>
					</label>
					<label class="field">
						<span>Country</span>
						<select name="country">
							<option value="">Anywhere</option>
							for _, c := range site.Countries {
								<option value={ c.Slug }>{ c.Name } ({ itoa(len(c.Sightings)) })</option>
							}
						</select>
					</label>
					<label class="field">
						<span>From</span>
						<input type="date" name="from"/>
					</label>
					<label class="field">
						<span>Until</span>
						<input type="date" name="to"/>
					</label>
					<label class="field">
						<span>Order</span>
						<select name="sort">
							<option value="new">Newest first</option>
							<option value="old">Oldest first</option>
						</select>
					</label>
					<div class="filters__actions">
						<button class="btn btn--ghost btn--small" type="reset">
							@components.Icon("x")
							<span>Clear</span>
						</button>
					</div>
				</div>
			</form>
			<ul class="filters__quick chips" aria-label="Quick picks" hidden data-wall-quick>
				for _, a := range topAnimals(site, 6) {
					<li><button class="chip" type="button" data-animal={ a.Slug } aria-pressed="false">{ a.Name }</button></li>
				}
			</ul>
			if len(site.Sightings) == 0 {
				<p class="empty">Nothing here but grass. Run the seed and come back.</p>
			} else {
				<ul id="wall" class="cards" role="list">
					for _, s := range site.Sightings {
						<li { components.FilterAttrs(s)... }>
							@components.SightingCard(s)
						</li>
					}
				</ul>
				<p class="empty" data-wall-empty hidden>No sightings match. Try another animal, or clear the filters.</p>
				<div class="wall__more">
					<button class="btn btn--forest" type="button" data-wall-more hidden>
						<span>Show more sightings</span>
						@components.Icon("arrow-right")
					</button>
				</div>
			}
		</section>
		<section class="moving section wrap" aria-labelledby="moving-title">
			<div class="section__head">
				<div>
					<h2 id="moving-title">On the move in <em class="script">{ safari.MonthNames[thisMonth()] }</em></h2>
					<p class="section__note">Where Africa's great herds are this month.</p>
				</div>
				<a class="tally__link" href="/migrations/">
					<span>Follow the whole year</span>
					@components.Icon("arrow-right")
				</a>
			</div>
			<ul class="moving__list" role="list">
				for _, r := range safari.Routes {
					<li class="moving__card">
						<a class="moving__link" href={ templ.SafeURL("/migrations/#" + r.Slug) }>
							<span class="moving__frame" data-moving>
								<svg class="moving__map" viewBox={ r.ViewBox() } preserveAspectRatio="xMidYMid slice" aria-hidden="true">
									<g class="moving__land">
										for _, o := range safari.Outlines() {
											<path d={ o.D }></path>
										}
									</g>
									<path class="moving__trail" d={ r.D() } style={ templ.SafeCSS("stroke-width:" + scaled(r, .6)) }></path>
									<circle class="moving__pulse" cx={ stopX(r.Months[thisMonth()]) } cy={ stopY(r.Months[thisMonth()]) } r={ scaled(r, 3.4) }></circle>
									<circle class="moving__dot" cx={ stopX(r.Months[thisMonth()]) } cy={ stopY(r.Months[thisMonth()]) } r={ scaled(r, 1.8) }></circle>
								</svg>
							</span>
							<span class="moving__text">
								<span class="moving__animal">{ r.Animal }</span>
								<strong class="moving__name">{ r.Name }</strong>
								<span class="moving__place">
									@components.Icon("map-pin")
									{ r.Months[thisMonth()].Place }
								</span>
								<span class="moving__caption">{ r.Months[thisMonth()].Caption }</span>
							</span>
						</a>
					</li>
				}
			</ul>
		</section>
		<section class="grassline" aria-labelledby="grass-title">
			<div class="wrap">
				<div class="section__head">
					<div>
						<h2 id="grass-title">Who's in the <em class="script">grass?</em></h2>
						<p class="section__note">One of each of the most-seen animals. <span class="for-mouse">Point at one to say hello.</span><span class="for-touch">Tap one to say hello.</span></p>
					</div>
				</div>
			</div>
			<div class="grassline__field">
				<ul class="grassline__animals" role="list">
					for _, spot := range safari.Spots(site.Pick(7)) {
						<li class={ "peeker", templ.KV("peeker--back", spot.Back) } style={ templ.SafeCSS("left:" + spot.Left) }>
							<a href={ templ.SafeURL(safari.SightingURL(spot.Sighting)) }>
								<span class="peeker__tag">{ safari.AnimalName(spot.Sighting.Species) } · { safari.Place(spot.Sighting) }</span>
								<span class="peeker__window">
									<img src={ safari.Sized(safari.Photo(spot.Sighting), "small") } alt={ safari.Alt(spot.Sighting) } loading="lazy" width="240" height="240"/>
								</span>
							</a>
						</li>
					}
				</ul>
				<svg class="grassline__front" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
					for i, d := range safari.Grass(42, 10, 40, 120) {
						<path class={ "blade", "blade--" + itoa(i%4) } d={ d }></path>
					}
				</svg>
			</div>
		</section>
		<section class="section countries wrap" aria-labelledby="countries-title">
			<div class="section__head">
				<div>
					<h2 id="countries-title">Pick a <em class="script">country</em></h2>
					<p class="section__note">The taller a country on the 3D map, the more animals were seen there. <span class="for-touch">Swipe for more.</span></p>
				</div>
				<a class="tally__link" href="/stats/">
					<span>See the numbers</span>
					@components.Icon("arrow-right")
				</a>
			</div>
			<ul class="chips">
				for _, c := range site.Countries {
					<li>
						<a class="chip" href={ templ.SafeURL("/countries/" + c.Slug) }>
							@components.Silhouette(c.Code, "")
							<span>{ c.Name }</span>
							<span class="chip__count">{ itoa(len(c.Sightings)) }</span>
						</a>
					</li>
				}
			</ul>
		</section>
	}
}
