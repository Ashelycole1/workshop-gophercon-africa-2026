package components

import (
	"workshop/internal/domain/sighting"
	"workshop/web/safari"
)

templ SightingCard(s sighting.Sighting) {
	<article class="card">
		<a class="card__photo" href={ templ.SafeURL(safari.SightingURL(s)) } tabindex="-1" aria-hidden="true">
			if photo := safari.Thumb(s); photo != "" {
				<img src={ photo } alt={ safari.Alt(s) } loading="lazy" decoding="async" width="500" height="375"/>
			} else {
				<span class="card__nophoto">{ safari.Emoji(safari.AnimalName(s.Species)) }</span>
			}
			<span class="card__badge" aria-hidden="true">{ safari.Emoji(safari.AnimalName(s.Species)) }</span>
		</a>
		<div class="card__body">
			<h3 class="card__title">
				<a href={ templ.SafeURL(safari.SightingURL(s)) }>{ safari.AnimalName(s.Species) }</a>
			</h3>
			if s.Species.ScientificName != "" {
				<p class="card__scientific">{ s.Species.ScientificName }</p>
			}
			<ul class="card__meta">
				<li><span aria-hidden="true">📅</span> <time datetime={ safari.ISODate(s) }>{ safari.Date(s) }</time></li>
				<li><span aria-hidden="true">📍</span> { safari.Place(s) }, { safari.CountryName(s) }</li>
				<li><span aria-hidden="true">👤</span> Spotted by { safari.Spotter(s) }</li>
			</ul>
			@WeatherChip(s)
		</div>
	</article>
}

templ SightingGrid(items []sighting.Sighting) {
	if len(items) == 0 {
		<p class="empty">Nothing here but grass... or is there? 🌾</p>
	} else {
		<ul id="sightings" class="cards" role="list">
			for _, s := range items {
				<li class="reveal" { FilterAttrs(s)... }>
					@SightingCard(s)
				</li>
			}
		</ul>
	}
}
