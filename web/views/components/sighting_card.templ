package components

import (
	"workshop/internal/domain/sighting"
	"workshop/web/safari"
)

templ SightingCard(s sighting.Sighting) {
	<article class="card">
		<a class="card__photo" href={ templ.SafeURL(safari.SightingURL(s)) } tabindex="-1" aria-hidden="true">
			if photo := safari.Thumb(s); photo != "" {
				<img src={ photo } alt={ safari.Alt(s) } loading="lazy" decoding="async" width="500" height="375"/>
			} else {
				<span class="card__nophoto">
					@Icon("paw-print")
				</span>
			}
		</a>
		<div class="card__body">
			<h3 class="card__title">
				<a href={ templ.SafeURL(safari.SightingURL(s)) }>{ safari.AnimalName(s.Species) }</a>
			</h3>
			if s.Species.ScientificName != "" {
				<p class="card__scientific">{ s.Species.ScientificName }</p>
			}
			<ul class="card__meta">
				<li>
					@Icon("calendar-blank")
					<time datetime={ safari.ISODate(s) }>{ safari.Date(s) }</time>
				</li>
				<li>
					@Icon("map-pin")
					<span>{ safari.Place(s) }, { safari.CountryName(s) }</span>
				</li>
				<li>
					@Icon("binoculars")
					<span>Spotted by { safari.Spotter(s) }</span>
				</li>
			</ul>
			@WeatherChip(s)
		</div>
	</article>
}

templ SightingGrid(items []sighting.Sighting) {
	if len(items) == 0 {
		<p class="empty">Nothing here but grass. Try another animal or country.</p>
	} else {
		<ul id="sightings" class="cards" role="list">
			for _, s := range items {
				<li class="reveal" { FilterAttrs(s)... }>
					@SightingCard(s)
				</li>
			}
		</ul>
	}
}
