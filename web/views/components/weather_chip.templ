package components

import (
	"workshop/internal/domain/sighting"
	"workshop/web/safari"
)

templ WeatherChip(s sighting.Sighting) {
	if sky, ok := safari.Weather(s); ok {
		<p class={ "wx", "wx--" + sky.Kind } title={ sky.Detail }>
			<span class="wx__icon" aria-hidden="true">{ sky.Icon }</span>
			<span class="wx__temp">{ sky.Temp }</span>
			<span class="wx__word">{ sky.Word }</span>
			<span class="wx__verdict">{ sky.Verdict }</span>
		</p>
	}
}
