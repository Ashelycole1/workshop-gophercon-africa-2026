package components

import (
	"workshop/internal/domain/sighting"
	"workshop/web/safari"
)

templ AfricaMap(sightings []sighting.Sighting, highlight string, viewBox string, label string) {
	<svg class="africa-map" viewBox={ viewBox } role="img" aria-label={ label } preserveAspectRatio="xMidYMid meet">
		<g class="africa-map__land">
			for _, o := range safari.Outlines() {
				<path
					d={ o.D }
					if o.Code == highlight {
						class="is-highlight"
					}
				></path>
			}
		</g>
		<g class="africa-map__dots">
			for _, s := range sightings {
				<circle cx={ safari.X(s) } cy={ safari.Y(s) } r="4.5">
					<title>{ safari.AnimalName(s.Species) }, { safari.Place(s) }</title>
				</circle>
			}
		</g>
	</svg>
}
